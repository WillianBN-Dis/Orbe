<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(AgendaTargetFramework)' != ''">$(AgendaTargetFramework)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Agenda.App</RootNamespace>
    <UseMaui>true</UseMaui><SingleProject>true</SingleProject>
    <MauiVersion>10.0.110</MauiVersion>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationTitle>Orbe</ApplicationTitle>
    <ApplicationId>br.com.agendafinanceira.app</ApplicationId>
    <ApplicationDisplayVersion>2.0.0</ApplicationDisplayVersion><ApplicationVersion>20004</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <!-- Avoid missing JNI callbacks (MauiApplication.n_onCreate) in standalone Release APKs. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <ApplicationDisplayVersion>2.0.0</ApplicationDisplayVersion><ApplicationVersion>20004</ApplicationVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ApplicationVersion>20005</ApplicationVersion>
  </PropertyGroup>
  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#10172E" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0D101B" BaseSize="112,112" />
    <MauiImage Include="Resources\Images\*.svg" />
<MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="..\..\licenses\*" LogicalName="licenses/%(Filename)%(Extension)" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <ProjectReference Include="..\Agenda.Core\Agenda.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <ProjectReference Include="../../tools/Orbe.Import/Orbe.Import.csproj" />
  </ItemGroup>
</Project>
